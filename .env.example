# Database (native Postgres — no Docker)
DATABASE_URL=postgresql://threads:threads@127.0.0.1:5432/threads_automation
DATABASE_POOL_SIZE=20

# Redis (native — no Docker)
REDIS_URL=redis://127.0.0.1:6379

# API
API_PORT=3000
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRY=24h
ENCRYPTION_KEY=32-char-encryption-key-here!!
PUBLIC_BASE_URL=http://localhost:3000
UPLOAD_DIR=

# Playwright
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_TIMEOUT=30000
# Safety override: when true, always dry-run even if live toggle is ON
PLAYWRIGHT_DRY_RUN=true

# Email (SendGrid) - optional for dev
SENDGRID_API_KEY=
EMAIL_FROM=noreply@threads-automation.com

# Ops alerts + optional canary (FR-800)
SLACK_WEBHOOK_URL=
ENABLE_CANARY=false
CANARY_THREADS_USERNAME=
CANARY_THREADS_PASSWORD=

# Logging
LOG_LEVEL=info

# Frontend
VITE_API_URL=http://localhost:3000/v1

# AI Content Generation (v3.0)
# Providers: claude | codex | openrouter | mock
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GITHUB_API_KEY=
GITHUB_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_MONTHLY_BUDGET_CENTS=5000
AI_GEN_PER_MINUTE=10
