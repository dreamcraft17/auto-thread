# Database
DATABASE_URL=postgresql://threads:threads@localhost:5432/threads_automation
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3000
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRY=24h
ENCRYPTION_KEY=32-char-encryption-key-here!!

# Playwright
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_DRY_RUN=true

# Email (SendGrid) - optional for dev
SENDGRID_API_KEY=
EMAIL_FROM=noreply@threads-automation.com

# Logging
LOG_LEVEL=info

# Frontend
VITE_API_URL=http://localhost:3000/v1
